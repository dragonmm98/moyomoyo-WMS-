DATABASE_URL=postgresql://wms:wms@localhost:4444/wms?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
# Browser requests use the frontend's same-origin /wms-data proxy by default.
API_PROXY_TARGET=http://127.0.0.1:4000/api/v1
# Extra hostnames allowed to load the Next.js development server.
# ngrok-free.app subdomains are already enabled by next.config.ts.
# ALLOWED_DEV_ORIGINS=dev.example.test,192.168.1.20
# Set only when deploying the API on a separate public origin.
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# Comma-separated in production. Development automatically permits private-LAN :3000 origins.
WEB_ORIGIN=http://localhost:3000
HOST=0.0.0.0
ADMIN_EMAIL=admin@moyomoyo.com
ADMIN_PASSWORD=MoyomoyoAdmin1
ADMIN_NAME=Javohir
